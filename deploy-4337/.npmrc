# permissionless@0.2.x declares an OPTIONAL peer dependency on ox@^0.8.0, but
# viem@2.5x depends on ox@0.14.x. Those versions work together at runtime (the
# deploy script typechecks and dry-runs against them), but npm@>=7 treats the
# mismatched optional peer as a hard ERESOLVE error on a fresh install.
# legacy-peer-deps restores npm@6 behavior (optional peers are not enforced).
legacy-peer-deps=true
