# deploy-4337 — gasless infra deploy via ERC-4337 + Pimlico.
# Copy to .env (gitignored) and fill in. The deployer key needs NO native balance;
# gas is sponsored by Pimlico.

# --- Required ---
CHAIN_ID=11155111                                   # target chain id (11155111 = Sepolia)
RPC_URL=https://eth-sepolia.g.alchemy.com/v2/<key>  # a normal RPC endpoint for the chain
PRIVATE_KEY=0x<deployer-key>                         # signs UserOps; no native ETH required

# Pimlico paymaster/bundler — set the API key, OR a full PIMLICO_URL (not both needed)
PIMLICO_API_KEY=<from dashboard.pimlico.io>
# PIMLICO_URL=https://api.pimlico.io/v2/11155111/rpc?apikey=<key>

# --- Optional ---
# PIMLICO_SPONSORSHIP_POLICY_ID=sp_xxx              # recommended (free testnet sponsorship)
# ENTRYPOINT=0x0000000071727De22E5E9d8BAf0edAc6f37da032   # EntryPoint v0.7 (default)
# FORS_VERIFIER_SALT=0x...                          # override only to change addresses
# SPHINCS_VERIFIER_SALT=0x...
# FACTORY_SALT=0x...
# DRY_RUN=1                                         # same as `npm run deploy:dry` / --dry-run
